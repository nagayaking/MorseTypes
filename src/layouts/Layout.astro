---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import "../styles/button.css"
---
<!doctype html>
<html lang="jp" data-theme="DARK">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body>
		<Header />
		<slot />
		<Footer />
	</body>
</html>

<style is:global>
	/* 上にあるデモからカラーに関することだけ抜粋 */

	/* 「LIGHT」テーマのカラー設定 */
	:root[data-theme='LIGHT'] {
	--color-background: #F5F5F5;
	--color-main: #6D4C41;
	--color-sub: #FF9800;
	}

	/* 「DARK」テーマのカラー設定 */
	:root[data-theme='DARK'] {
	--color-background: #37474F;
	--color-main: #64B5F6;
	--color-sub: #F5F5F5;
	}
	
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		color: var(--color-main);
		background: var(--color-background);
	}
	
	.background {
	background: var(--color-background);
	}

	.main-text {
	color: var(--color-main);
	}

	.sub-text {
	color: var(--color-sub);
	}

	.btn {
    appearance: none;
    background-color: 
    transparent;
    border: 2px solid 
    var(--color-main);
    border-radius: 15px;
    box-sizing: border-box;
    color: 
    var(--color-main);
    cursor: pointer;
    display: inline-block;
    font-family: Roobert,-apple-system,BlinkMacSystemFont,"Segoe UI",Helvetica,Arial,sans-serif,"Apple Color Emoji","Segoe UI Emoji","Segoe UI Symbol";
    font-size: 16px;
    font-weight: 600;
    line-height: normal;
    margin: 0;
    min-height: 60px;
    min-width: 0;
    outline: none;
    padding: 16px 24px;
    text-align: center;
    text-decoration: none;
    transition: all 300ms cubic-bezier(.23, 1, 0.32, 1);
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
    max-width: 100%;
    will-change: transform;
    }

    .btn:disabled {
    pointer-events: none;
    }

    .btn:hover {
    color: 
    var(--color-background);
    background-color: 
    var(--color-main);
    box-shadow: 
    rgba(0, 0, 0, 0.25) 0 8px 15px;
    transform: translateY(-2px);
    }

    .btn:active {
    box-shadow: none;
    transform: translateY(0);
    }

    /* CSSファイルの記述例 */
.normal-text {
    color: black;
    font-size: 24px;
}

.error-text {
    color: red;
    font-size: 24px;
    font-weight: bold;
    /* 必要に応じて、間違えた文字だけアニメーションで揺らすことも可能です！ */
}

/* 全体の横並びコンテナ（WordDisplayの一番外側） */
.word-display-container {
  display: flex;
  justify-content: center; /* 画面の中央に配置 */
  gap: 2rem;               /* 文字ごとの間隔（少し広めが見やすいです） */
  font-size: 2rem;         /* 全体の文字サイズ */
  font-weight: bold;
}

/* 1文字ごとのグループ（ひらがなとモールスを縦に並べる箱） */
.character-group {
  display: flex;
  flex-direction: column;
  align-items: center;     /* 縦に並べた上で、中央揃えにする */
  gap: 0.5rem;             /* ひらがなとモールス信号の上下の隙間 */
}

/* 上段：ひらがな部分 */
.hiragana {
  color: #333333;          /* 常に固定の濃いグレー */
}

/* 下段：モールス信号のコンテナ */
.morse-code {
  display: flex;
  font-family: monospace;  /* 「・」や「－」の幅を均等にするため等幅フォントを指定 */
  letter-spacing: 0.1rem;  /* 記号同士がくっつきすぎないように隙間をあける */
  font-size: 1.5rem;       /* ひらがなより少し小さめにするとバランスが良いです */
}

/* =========================================
   状態ごとの色の設定（モールス信号）
   ========================================= */

/* 1. 過去（すでに入力完了） */
.morse-past {
  color: #cccccc;          /* 背景に溶け込むような薄いグレー */
  opacity: 0.6;            /* さらに少し透明にして存在感を消す */
}

/* 2. 未来（これから入力する文字） */
.morse-future {
  color: #888888;          /* 通常のグレー */
}

/* 3. 現在（入力中）の各記号の分解パーツ */
.morse-normal {
  color: #333333;          /* 今から打つべき記号。未来の文字より濃くしてフォーカスさせる */
}

.morse-correct {
  color: #10b981;          /* 正解（鮮やかなエメラルドグリーン） */
  text-shadow: 0 0 8px rgba(16, 185, 129, 0.4); /* 少し光らせるとゲームっぽさが出ます */
}

.morse-error {
  color: #ef4444;          /* 失敗・ミス（警告の赤） */
  text-shadow: 0 0 8px rgba(239, 68, 68, 0.4);
}
</style>
