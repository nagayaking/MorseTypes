---
const SITE_TITLE = "MorseTypes";
---

<header>
    <nav>
        <a href={import.meta.env.BASE_URL}>
          <h1>{SITE_TITLE}</h1>
        </a>
    </nav>
</header>
<style>
  header {
    position: absolute;
    margin: 0;
    padding: 0 1em;
    background: var(--color-background);
    box-shadow: 0 2px 8px rgba(var(--black), 5%);
    z-index: 1;
  }
  h1 {
    margin: 0;
    font-size: 1.5em;
  }

  h1 a,
  h1 a.active {
    text-decoration: none;
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  nav a {
    padding: 1em 0.5em;
    color: var(--black);
    border-bottom: 4px solid transparent;
    text-decoration: none;
  }
  nav a.active {
    text-decoration: none;
    border-bottom-color: var(--accent);
  }
</style>